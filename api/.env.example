PORT=3000

# Requerida por el agente de cobro (POST /agent/message). Nunca la expongas al
# cliente — el agente vive solo en el backend.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HSK Chain testnet
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133

# Contratos desplegados (ver contracts/README.md)
SALES_REGISTRY_ADDRESS=0x47a1e2F914C6aB7523804c8eD2fE76df149735e0
STABLECOIN_ADDRESS=0x59e12F42dE357De29AA810E27C0c02650Ea66e85
STABLECOIN_DECIMALS=6

# Wallet del comercio que recibe los pagos (destino de las transferencias ERC-20)
# Juan
COMERCIO_ADDRESS=0x38a8CF566De07aFA52E0a65f7598d5dEa2c9c11a

# Llave privada del backend (owner de SalesRegistry) — llama registrarVenta()
# cuando el listener confirma el pago onchain. Debe ser una llave hex de 32 bytes
# con prefijo 0x, por ejemplo 0x + 64 caracteres hex. Nunca la expongas al cliente.
PRIVATE_KEY=0x6b2af00be5a14cff0d7f7e3b38f42b9d4a8995ab9841302766e846f0d0e51eec
ADDRESS=0x6475f12A40d7bb51e965639eFA7aC4d4Ab3fE23b
